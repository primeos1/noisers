# Base URL for the Laravel API. Leave unset in development to use the
# machine running Metro on port 8000 (php artisan serve --host 0.0.0.0).
# EXPO_PUBLIC_API_URL=https://api.noisersfc.com/api

# Public web site, for links the committee shares (e.g. the squad sign-up
# link in Settings). Defaults to https://noisersfc.com.
# EXPO_PUBLIC_SITE_URL=https://noisersfc.com
